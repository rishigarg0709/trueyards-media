// recurring device: a thin teal "gate" frame (two posts and a lintel) that draws on around key captions
const gate=(sc,x,y,wd,h)=>{const g=svg(sc,'',`<path d="M${x} ${y+h} V${y} H${x+wd} V${y+h}" fill="none" stroke="#28c39d" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" pathLength="1" stroke-dasharray="1" stroke-dashoffset="1" style="filter:drop-shadow(0 0 8px rgba(40,195,157,.6))"/>`);const p=g.querySelector('path');return (t,a)=>{p.style.strokeDashoffset=1-eio((t-a)/.7)}};
const HOOKEV=wt('not');
// 1. HOOK: bright sunlit pol lane, carved house fronts, gate at the end; push down the lane from frame 0; line spoken from 0 s; no text before 1.55 s
const hookImg=sc=>box(sc,'m1',560,980,'50% 50%');
add(0,sc=>{const b=hookImg(sc);b.im.style.filter='brightness(1.08) saturate(1.08)';mk(sc,'sh','background:'+GTOP+')');const g=mk(sc,'sh','background:'+GB(46)+';opacity:0');
 const k=T(sc,'K ts','left:72px;top:1170px;color:#BFF5E4',[['●',1.55,'c'],['Old',1.55],['Ahmedabad',1.55]]);
 const h1=T(sc,'M ts','left:70px;top:1215px;width:900px',[['Not',Math.max(1.6,HOOKEV)],['houses.',wt('houses')]]);
 const h2=T(sc,'H ts','left:70px;top:1305px;width:900px;font-size:118px',[['Escape',wt('escape'),'hl',1],['\n'],['routes.',wt('routes')]]);
 return t=>{const s=1.04+.16*eio(t/5.2);const sk=shake(t,HOOKEV,5);b.style.transform=`translate(${sk}px,${sk*.4}px) scale(${s})`;
  g.style.opacity=cl((t-1.4)/.3);rv(k,t);rv(h1,t);rv(h2,t)}});
// 2. Same lane, the chabutro and nearest facades, pull-out. "This is a pol. Fifty to a hundred homes"
add(wt('this')-.1,sc=>{const b=box(sc,'m1',650,820,'50% 50%');mk(sc,'sh','background:'+GB(50));
 const k=T(sc,'K ts','left:72px;top:1250px;color:#BFF5E4',[['●',wt('this'),'c'],['Ahmedabad',wt('this')],['·',wt('pol')],['pol',wt('pol')]]);
 const n=mk(sc,'H ts','left:70px;top:1300px;width:940px;font-size:150px;opacity:0','');
 const h=T(sc,'M ts','left:70px;top:1470px;width:900px',[['homes,',wt('homes')],['shared',wt('sharing')],['walls.',wt('walls'),'hl']]);
 const b0=wt('this')-.1,tf=wt('fifty')-b0,th=wt('hundred')-b0;
 return t=>{b.style.transform=`scale(${1.75-.25*eio(t/3.6)})`;rv(k,t);rv(h,t);
  if(t<tf){n.style.opacity=0}else{n.style.opacity=1;n.innerHTML=t<th?'50':'50 <span style="font-weight:500;font-size:.5em">to</span> <span class="hl">100</span>';n.style.transform=`scale(${t<th?.9+.1*eb((t-tf)/.25):.9+.1*eb((t-th)/.25)})`;n.style.transformOrigin='0 50%'}}},true);
// 3. Real photo: an old Ahmedabad pol house, framed panel, push in. "...behind one gate."
add(wt('behind')-.1,sc=>{const b=panel(sc,'r2',230,1000,'50% 72%',540,640);
 const gd=gate(sc,60,1265,560,230);
 const h=T(sc,'H ts','left:96px;top:1310px;width:860px;font-size:104px',[['One',wt('one')],['gate.',wt('gate'),'hl',1]]);
 const b0=wt('behind')-.1,tg=wt('one')-b0;
 return t=>{b.im.style.transform=`scale(${1.04+.08*eio(t/2.4)})`;gd(t,tg-.2);rv(h,t)}},true);
// 4. The heavy studded pol gate, tilt up from the doors. "Why build a street like a fortress?"
add(wt('why')-.1,sc=>{const b=box(sc,'m4',540,1100,'50% 50%');mk(sc,'sh','background:'+GB(52));
 const k=T(sc,'K ts','left:72px;top:1250px;color:#BFF5E4',[['●',wt('why'),'c'],['Why',wt('why')],['build',wt('build')],['a',wt('a',3)],['street',wt('street')]]);
 const h=T(sc,'H ts','left:70px;top:1300px;width:900px;font-size:118px',[['Like',wt('like')],['a',wt('like')],['\n'],['fortress?',wt('fortress'),'hl',1]]);
 return t=>{b.style.transform=`scale(1.32) translateY(${-60+70*eio(t/2)}px)`;rv(k,t);rv(h,t)}},true);
// 5. Real photo: carved old-city facade (Ashtapad Derasar), framed, year counter. "In the 1700s, as Mughals and Marathas fought over the city,"
add(wt('in',2)-.1,sc=>{const b=panel(sc,'r1',230,1000,'50% 22%',540,500);
 const y=mk(sc,'Y ts','left:66px;top:1150px;opacity:0','1700s');
 const k=T(sc,'K ts','left:72px;top:1420px;color:#BFF5E4',[['●',wt('mughals'),'c'],['Mughals',wt('mughals')],['vs',wt('and')],['Marathas',wt('marathas')]]);
 const h=T(sc,'M ts','left:70px;top:1470px;width:900px',[['fight',wt('fought')],['over',wt('over')],['the',wt('city')],['city.',wt('city'),'hl']]);
 const b0=wt('in',2)-.1,ty=wt('1700s')-b0;
 return t=>{b.im.style.transform=`scale(${1.06+.06*eio(t/4.4)}) translateX(${18-36*eio(t/4.4)}px)`;if(t>=ty)slam(y,t,ty,1.5,0);else y.style.opacity=0;rv(k,t);rv(h,t)}},true);
// 6. Aerial over the dense old city, slow drift. "its old walls stopped keeping robbers out."
add(wt('its')-.1,sc=>{const b=box(sc,'m3',540,800,'50% 50%');mk(sc,'sh','background:'+GB(50));
 const k=T(sc,'K ts','left:72px;top:1250px;color:#BFF5E4',[['●',wt('its'),'c'],['City',wt('walls',2)],['walls',wt('walls',2)],['failed',wt('stopped')]]);
 const h=T(sc,'H ts','left:70px;top:1300px;width:900px;font-size:110px',[['Robbers',wt('robbers')],['\n'],['got',wt('out')],['in.',wt('out'),'hl',1]]);
 return t=>{b.style.transform=`scale(${1.3+.05*eio(t/2.9)}) translateX(${30-60*eio(t/2.9)}px)`;rv(k,t);rv(h,t)}},true);
// 7. Gate again: doors, then tilt up to the guard room above. "So neighbours locked themselves in. A guard lived above the gate."
add(wt('so')-.1,sc=>{const b=box(sc,'m4',540,420,'50% 50%');mk(sc,'sh','background:'+GB(52));
 const h=T(sc,'H ts','left:70px;top:1300px;width:900px;font-size:108px',[['Locked',wt('locked')],['\n'],['themselves',wt('themselves')],['in.',wt('in',3),'hl',1]]);
 const tg=mk(sc,'tag','left:72px;top:1250px;opacity:0','Guard room');
 const h2=T(sc,'H ts','left:70px;top:1300px;width:900px;font-size:108px',[['Guard',wt('guard'),'hl'],['\n'],['above',wt('above')],['the',wt('the',3)],['gate.',wt('gate',2)]]);
 const br=corners(sc,330,300,750,700,56,6);
 const b0=wt('so')-.1,tgd=wt('a',5)-b0;
 return t=>{const u=eio((t-tgd+.3)/1.1);b.style.transform=`scale(${1.3+.45*u}) translateY(${-200+260*u}px)`;
  if(t<tgd){rv(h,t);h2.style.opacity=0;tg.style.opacity=0;br.forEach(e=>e.style.opacity=0)}else{h.style.opacity=0;h2.style.opacity=1;rv(h2,t);fade(tg,t,tgd,.2,10);crn(br,t,tgd+.5)}}},true);
// 8. Real photo: a narrow stair passage in the old city, push up. "Narrow passages,"
add(wt('narrow')-.1,sc=>{const b=panel(sc,'r3',230,1000,'50% 62%',540,600);b.im.style.filter='brightness(1.3) saturate(1.05)';
 const h=T(sc,'H ts','left:70px;top:1300px;width:900px;font-size:118px',[['Narrow',wt('narrow')],['\n'],['passages.',wt('passages'),'hl',1]]);
 return t=>{b.im.style.transform=`scale(${1.05+.09*eio(t/2)}) translateY(${-14*t}px)`;rv(h,t)}},true);
// 9. REVEAL (tell a friend, about 59%): a carved house front, door ajar, a passage through to another lane; push into the gap; 0.4 s hold on "disguised"
add(wt('some',2)-.1,sc=>{const b=box(sc,'m2',615,1080,'50% 50%');b.im.style.filter='brightness(1.05)';mk(sc,'sh','background:'+GB(52));
 const tg=mk(sc,'tag','left:72px;top:1190px;opacity:0','Tell a friend');
 const h=T(sc,'H ts','left:70px;top:1250px;width:940px;font-size:104px',[['Disguised',wt('disguised'),'hl',1],['as',wt('as')],['\n'],['house',wt('fronts',2)],['fronts.',wt('fronts',2)]]);
 const h2=T(sc,'M ts','left:70px;top:1480px;width:900px',[['Families',wt('families')],['slip',wt('slip')],['away.',wt('away'),'c']]);
 const b0=wt('some',2)-.1,td=wt('disguised')-b0,tl=wt('let')-b0;
 return t=>{const p=t<td?.5*eio(t/td):t<td+.4?.5:.5+.5*eio((t-td-.4)/(tl+1.6-td));b.style.transform=`scale(${1.12+.7*p}) translateX(${shake(t,td,5)}px)`;fade(tg,t,td-.1,.2,10);if(t<td-.1)tg.style.opacity=0;rv(h,t);rv(h2,t)}},true);
// 10. Aerial over joined rooftops; a teal path hops roof to roof. "Even the rooftops joined, house to house."
add(wt('even')-.1,sc=>{const b=box(sc,'m3',600,900,'50% 50%');mk(sc,'sh','background:'+GB(54));
 const pts=[[150,1060],[330,900],[520,960],[700,800],[900,860]];
 const pth=svg(sc,'',`<polyline points="${pts.map(p=>p.join(' ')).join(',')}" fill="none" stroke="#28c39d" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1 0" pathLength="1" style="filter:drop-shadow(0 0 10px rgba(40,195,157,.8))"/>`+pts.map((p,i)=>`<circle class="rd" cx="${p[0]}" cy="${p[1]}" r="17" fill="#fff" stroke="#28c39d" stroke-width="7" style="opacity:0"/>`).join(''));
 const pl=pth.querySelector('polyline'),ds=[...pth.querySelectorAll('.rd')];
 const h=T(sc,'H ts','left:70px;top:1300px;width:900px;font-size:110px',[['Rooftops',wt('rooftops')],['\n'],['joined.',wt('joined'),'hl',1]]);
 const k=T(sc,'K ts','left:72px;top:1250px;color:#BFF5E4',[['●',wt('house',2),'c'],['House',wt('house',2)],['to',wt('to',2)],['house',wt('house',3)]]);
 const b0=wt('even')-.1,ta=wt('rooftops')-b0,te=wt('house',3)+.3-b0;
 return t=>{b.style.transform=`scale(${1.22+.06*eio(t/3.6)}) translateX(${-20+40*eio(t/3.6)}px)`;const p=eio((t-ta)/(te-ta));pl.style.strokeDasharray=`${p} 1`;ds.forEach((d,i)=>{d.style.opacity=p>=i/4-.01&&t>=ta?1:0});rv(h,t);rv(k,t)}},true);
// 11. Real photo: Ashtapad Derasar facade in the old city, tilt up; year slam. "In 2017, this old city became India's first World Heritage City."
add(wt('in',5)-.1,sc=>{const b=panel(sc,'r1',230,1000,'50% 78%',540,500);
 const y=mk(sc,'Y ts','left:66px;top:1120px;opacity:0','2017');
 const k=T(sc,'K ts','left:72px;top:1390px;color:#BFF5E4',[['●',wt('india\'s'),'c'],['India\'s',wt('india\'s')],['first',wt('first')]]);
 const h=T(sc,'M ts','left:70px;top:1440px;width:940px',[['World',wt('world')],['Heritage',wt('heritage'),'hl'],['City.',wt('city',3)]]);
 const b0=wt('in',5)-.1,ty=wt('2017')-b0;
 return t=>{b.im.style.transform=`scale(${1.06+.04*eio(t/5)}) translateY(${40-80*eio(t/5)}px)`;if(t>=ty)slam(y,t,ty,1.5,0);else y.style.opacity=0;rv(k,t);rv(h,t)}},true);
// 12. Real photo: a plain old pol house door, push toward the doorway. "So that plain old door... is it a house?"
add(wt('so',2)-.1,sc=>{const b=panel(sc,'r2',230,1000,'50% 74%',520,640);
 const gd=gate(sc,60,1265,520,230);
 const h=T(sc,'H ts','left:96px;top:1310px;width:860px;font-size:118px',[['A',wt('house',4)],['house?',wt('house',4),'hl',1]]);
 const b0=wt('so',2)-.1,th=wt('house',4)-b0;
 return t=>{b.im.style.transform=`scale(${1.05+.18*eio(t/2.8)})`;gd(t,th-.25);rv(h,t)}},true);
// 13. Loop: back to the lane of frame 0. "Or a way out?"
add(wt('or')-.1,sc=>{const b=hookImg(sc);b.im.style.filter='brightness(1.08) saturate(1.08)';mk(sc,'sh','background:'+GB(50));
 const h=T(sc,'H ts','left:70px;top:1300px;width:900px;font-size:118px',[['Or',wt('or')],['a',wt('a',7)],['\n'],['way',wt('way')],['out?',wt('out',2),'hl',1]]);
 return t=>{b.style.transform=`scale(${1.2-.16*eio(t/1.6)})`;rv(h,t)}},true);
