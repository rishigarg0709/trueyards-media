const scenes=SC.map((o,i)=>{const sc=mk(S,'sc','');S.insertBefore(sc,document.getElementById('brand'));return {sc,u:o.fn(sc),t0:o.t0,raw:o.raw,t1:i+1<SC.length?SC[i+1].t0:END,wipe:o.wipe}});
window.DUR=END;
const AIL='AI visualisation.';
const FINE=[[0,AIL+' Not a real building.'],[SC[1].t0,'Photo: Anjali Lokhande / Unsplash.'],[SC[2].t0,'Photo: Ritanuka Ghosh / Unsplash. Grills after burglaries (Free Press Journal, Apr 2022; The News Minute, Sep 2021).'],[SC[3].t0,AIL],[SC[4].t0,AIL+' Box grills trap people, delay firemen (Free Press Journal, Apr 2022; Asian Age, Oct 2018).'],[SC[5].t0,AIL+' Citizen Matters, Sep 2020.'],[SC[6].t0,AIL+' No fire shown. Bengaluru, 21 Sep 2021 (The News Minute, 23 Sep 2021).'],[SC[8].t0,AIL+' BBMP circular, 22 Sep 2021, citing building rules and the National Building Code 2016 (The News Minute).'],[SC[9].t0,AIL+' Mumbai fire brigade chief, Apr 2022 (Free Press Journal).'],[SC[11].t0,AIL],[SC[12].t0,AIL+' Education only, not advice.'],[OST,'']];
scenes.forEach(s=>{s.imgs=[...s.sc.querySelectorAll('img')];s.imgs.forEach(i=>{i.dataset.src=i.getAttribute('src');i.removeAttribute('src')})});
window.ready=Promise.all([document.fonts.ready,...[...document.images].filter(i=>i.getAttribute('src')).map(i=>i.decode().catch(()=>{}))]);
window.setT=t=>{const P=[];scenes.forEach((s,i)=>{const near=t>=s.t0-.4&&t<s.t1+.4;s.imgs.forEach(im=>{if(near&&!im.getAttribute('src')){im.src=im.dataset.src;P.push(im.decode().catch(()=>{}))}else if(!near&&im.getAttribute('src'))im.removeAttribute('src')})});
 draw(t);return P.length?Promise.all(P).then(()=>{draw(t)}):undefined};
const FLASH=[HOOKEV,wt('in'),wt('two'),wt('approval'),wt('open')];
const draw=t=>{window.GT=t;
 scenes.forEach((s,i)=>{const on=t>=s.t0&&t<s.t1;s.sc.style.display=on?'block':'none';
  if(on){const lt=t-s.t0;const n=8;if(i>0&&s.wipe&&lt<.32){const p=lt/.32;const prev=scenes[i-1];prev.sc.style.display='block';prev.u(t-prev.raw);
    s.sc.style.clipPath=`polygon(${(()=>{let a=[];for(let c=0;c<n;c++){const q=eo(cl(p*1.6-c*.07));const x0=c*1080/n,x1=(c+1)*1080/n+1;a.push(`${x0}px 0px`,`${x1}px 0px`,`${x1}px ${1920*q}px`,`${x0}px ${1920*q}px`,`${x0}px 0px`)}return a.join(',')})()})`}
   else s.sc.style.clipPath='none';
   s.u(t-s.raw)}});
 let ft='';FINE.forEach(([tt,s])=>{if(t>=tt)ft=s});document.getElementById('fine').textContent=ft;
 document.getElementById('brand').style.opacity=t>=OST?1-cl((t-OST)/.3):1;
 let fl=0;scenes.forEach((s,i)=>{if(i&&t>=s.t0&&!s.wipe)fl=Math.max(fl,.14*Math.exp(-(t-s.t0)/.06))});
 FLASH.forEach((e,j)=>{if(e!=null&&t>=e)fl=Math.max(fl,(j<1?.4:.28)*Math.exp(-(t-e)/.08))});document.getElementById('flash').style.opacity=fl;
 document.getElementById('fol').style.opacity=0;
};
</script></body></html>
