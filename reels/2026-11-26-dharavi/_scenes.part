// recurring device: thin green survey frame (corner brackets) that locks onto key areas, and a series tag
const HOOKEV=wt('ten');
const KC='#BFF5E4';
const num=(p,css)=>mk(p,'N ts',css+';opacity:0','');
const inr=n=>n.toLocaleString('en-IN');
const cnt=(e,t,a,du,f)=>{e.style.opacity=cl((t-a+.1)/.15);const p=eo((t-a)/du);e.textContent=f(p);return p};
// 1. HOOK: bright real Mumbai aerial (blue tarps beside a flyover), push-in from frame 0, line spoken from 0 s; no text before 1.55 s; "10 lakh" slams on 'ten'
const hookImg=sc=>box(sc,'tarps',560,820,'42% 50%');
add(0,sc=>{const b=hookImg(sc);b.im.style.filter='brightness(1.24) saturate(1.1) contrast(1.02)';mk(sc,'sh','background:'+GTOP+')');const g=mk(sc,'sh','background:'+GB(50)+';opacity:0');
 const tA=1.55;
 const k=T(sc,'K ts','left:72px;top:1090px;color:'+KC,[['●',tA,'c'],['Why',tA],['India',tA],['looks',tA],['like',tA],['this',tA],['#1',tA]]);
 const q=T(sc,'M ts','left:70px;top:1136px;width:980px;font-size:60px',[['Why',tA],['does',tA],['Mumbai',tA],['look',tA],['like',tA],['this?',tA,'hl']]);
 const n=mk(sc,'H ts','left:62px;top:1240px;width:960px;font-size:190px;opacity:0','10 lakh');
 const u=T(sc,'M ts','left:70px;top:1450px;width:940px',[['people',wt('people')],['·',wt('people')],['estimates',wt('people')]]);
 return t=>{b.style.transform=`scale(${1.06+.16*eio(t/3.4)}) translateY(${-20*eio(t/3.4)}px)`;g.style.opacity=cl((t-tA+.3)/.35);rv(k,t);rv(q,t);if(t>=HOOKEV)slam(n,t,HOOKEV,1.5,0);else n.style.opacity=0;rv(u,t);b.style.marginLeft=shake(t,HOOKEV,6)+'px'}});
// 2. AI hero aerial: sea of rooftops, glass towers at the edge; drone push. "...in less than two and a half square kilometres."
add(wt('in')-.1,sc=>{const b=box(sc,'e1',540,760,'50% 60%');b.im.style.filter='brightness(1.06) saturate(1.06)';mk(sc,'sh','background:'+GB(48));
 const k=T(sc,'K ts','left:72px;top:1196px;color:'+KC,[['●',wt('less'),'c'],['Less',wt('less')],['than',wt('than')],['2.5',wt('two')],['sq',wt('square')],['km',wt('kilometres')]]);
 const h=T(sc,'H ts','left:70px;top:1244px;width:960px;font-size:170px',[['2.39',wt('two'),'hl',1],['\n'],['sq',wt('square')],['km',wt('kilometres')]]);
 return t=>{b.style.transform=`scale(${1.16+.1*eio(t/4.6)}) translateY(${30-60*eio(t/4.6)}px)`;rv(k,t);rv(h,t)}},true);
// 3. Hero close on the roofs, pan. "This is Dharavi, right in the middle of Mumbai."
add(wt('this',2)-.1,sc=>{const b=box(sc,'e1',300,1100,'50% 72%');b.im.style.filter='brightness(1.08) saturate(1.06)';mk(sc,'sh','background:'+GB(50));
 const tg=mk(sc,'tag','left:72px;top:1190px;opacity:0','Mumbai · middle of the city');
 const h=T(sc,'H ts','left:70px;top:1262px;width:960px;font-size:150px',[['Dharavi',wt('dharavi'),'hl',1]]);
 return t=>{b.style.transform=`scale(1.9) translateX(${50-100*eio(t/3.2)}px)`;fade(tg,t,wt('middle')-(wt('this',2)-.1),.25,10);rv(h,t)}},true);
// 5. Real towers over older low-rise (framed landscape). "So how do you rebuild a place like this... and who pays?"
add(wt('so')-.1,sc=>{const b=panel(sc,'byculla',230,1020,'50% 50%',540,520);
 const k=T(sc,'K ts','left:72px;top:1250px;color:'+KC,[['●',wt('rebuild'),'c'],['How',wt('how')],['to',wt('rebuild')],['rebuild',wt('rebuild')],['it',wt('this',3)]]);
 const h=T(sc,'H ts','left:70px;top:1300px;width:960px;font-size:132px',[['Who',wt('who')],['pays?',wt('pays'),'hl',1]]);
 return t=>{b.im.style.transform=`scale(${1.08+.06*eio(t/4)}) translateX(${-30+60*eio(t/4)}px)`;rv(k,t);rv(h,t)}},true);
// 6. Master plan scale model, wide. "In May 2025, Maharashtra approved a master plan."
add(wt('in',3)-.1,sc=>{const b=box(sc,'e5',540,800,'50% 50%');b.im.style.filter='brightness(1.02)';mk(sc,'sh','background:'+GB(46));
 const y=mk(sc,'Y ts','left:66px;top:1120px;opacity:0;font-size:190px','May 2025');
 const h=T(sc,'M ts','left:70px;top:1360px;width:940px',[['Master',wt('master')],['plan',wt('plan'),'hl'],['approved',wt('plan')+.12]]);
 const b0=wt('in',3)-.1,ty=wt('may')-b0;
 return t=>{b.style.transform=`scale(${1.08+.08*eio(t/3.6)})`;if(t>=ty)slam(y,t,ty,1.4,0);else y.style.opacity=0;rv(h,t)}},true);
// 7. Push on the model's tower cluster. "About fifty-eight thousand homes, plus shops and workshops."
add(wt('about')-.1,sc=>{const b=box(sc,'e5',640,520,'50% 50%');b.im.style.filter='brightness(1.02)';mk(sc,'sh','background:'+GB(48));
 const n=num(sc,'left:56px;top:1180px;color:#fff;font-size:180px');
 const u=T(sc,'M ts','left:70px;top:1360px;width:960px;font-size:64px',[['homes',wt('homes')],['\n'],['+',wt('plus')],['13,468',wt('shops'),'hl'],['shops',wt('shops')],['and',wt('workshops')],['workshops',wt('workshops')]]);
 const b0=wt('about')-.1,tn=wt('fifty-eight')-b0;
 return t=>{b.style.transform=`scale(${1.7+.14*eio(t/4)})`;const p=cnt(n,t,tn,.8,p=>inr(Math.round(58532*p/4)*4));if(p>=1)n.textContent='58,532';rv(u,t)}},true);
// 8. Potters' lane, pull-out. "Here's the part most people don't know."
add(wt("here's")-.1,sc=>{const b=box(sc,'e2',540,900,'50% 50%');b.im.style.filter='brightness(1.14) saturate(1.04)';mk(sc,'sh','background:'+GB(50));
 const h=T(sc,'H ts','left:70px;top:1260px;width:960px;font-size:104px',[['Most',wt('most')],['people',wt('people',2)],['\n'],["don't",wt("don't")],['know',wt('know'),'hl',1],['this.',wt('know')+.1]]);
 return t=>{b.style.transform=`scale(${1.24-.12*eio(t/2.6)})`;rv(h,t)}},true);
// 9. Close on the flat, push in. "Eligible families on the ground floor since before 2000 get a 350 sq ft flat. Inside Dharavi. Free."
add(wt('eligible')-.1,sc=>{const b=box(sc,'e4',560,1000,'50% 50%');b.im.style.filter='brightness(1.06)';mk(sc,'sh','background:'+GB(44));
 const k=T(sc,'K ts','left:72px;top:1080px;color:'+KC,[['●',wt('eligible'),'c'],['Ground',wt('ground')],['floor',wt('floor')],['·',wt('before')],['before',wt('before')],['1',wt('2000')],['Jan',wt('2000')],['2000',wt('2000')]]);
 const n=num(sc,'left:56px;top:1130px;color:#fff;font-size:170px');
 const u=T(sc,'M ts','left:70px;top:1310px;width:960px',[['flat,',wt('flat')],['inside',wt('inside')],['Dharavi',wt('dharavi',2)]]);
 const st=mk(sc,'stamp','left:70px;top:1420px;opacity:0;font-size:84px','FREE');
 const b0=wt('eligible')-.1,tn=wt('three')-b0,tf=wt('free')-b0;
 return t=>{b.style.transform=`scale(${1.36+.16*eio(t/7)})`;rv(k,t);const p=cnt(n,t,tn,.7,p=>Math.round(350*p)+' sq ft');rv(u,t);if(t>=tf)slam(st,t,tf,1.8,-4);else st.style.opacity=0;b.style.marginLeft=shake(t,tf,7)+'px'}},true);
// 10. Real dense rooftops from above (the land), push-in. "The land pays the bill."
add(wt('land')-.1,sc=>{const b=box(sc,'aerial',540,700,'50% 40%');b.im.style.filter='brightness(1.12) saturate(1.05)';mk(sc,'sh','background:'+GB(48));
 const br=corners(sc,180,420,900,1020,50,6);
 const k=T(sc,'K ts','left:72px;top:1220px;color:'+KC,[['●',wt('land'),'c'],['Who',wt('pays',2)],['pays?',wt('pays',2)]]);
 const h=T(sc,'H ts','left:70px;top:1268px;width:960px;font-size:118px',[['The',wt('the',4)],['land',wt('land'),'hl',1],['\n'],['itself.',wt('bill')]]);
 return t=>{b.style.transform=`scale(${1.1+.12*eio(t/2.6)})`;crn(br,t,.3);rv(k,t);rv(h,t)}},true);
// 11. Rehab towers rising on railway land. "Rehab homes come first... then the extra space is sold."
add(wt('rehab')-.1,sc=>{const b=box(sc,'e3',540,700,'50% 50%');b.im.style.filter='brightness(1.0) saturate(1.04)';mk(sc,'sh','background:'+GB(46));
 const s1=mk(sc,'M ts','left:70px;top:1160px;width:960px;opacity:0','<span class="hl">1</span> Rehab homes first');
 const s2=mk(sc,'M ts','left:70px;top:1270px;width:960px;opacity:0','<span class="hl">2</span> Then extra space is sold');
 const k=mk(sc,'K ts','left:72px;top:1390px;color:'+KC+';opacity:0','● ≈ 9.5 crore sq ft rehab · then ≈ 13 crore sq ft sale');
 const b0=wt('rehab')-.1;
 return t=>{b.style.transform=`scale(${1.14+.08*eio(t/4.4)}) translateX(${20-40*eio(t/4.4)}px)`;fade(s1,t,wt('rehab')-b0,.25,24);fade(s2,t,wt('then')-b0,.25,24);fade(k,t,wt('sold')-b0,.3,10)}},true);
// 12. Tower tops, tilt up. "Phase one promises ten thousand homes in about eighteen months."
add(wt('phase')-.1,sc=>{const b=box(sc,'e3',560,420,'50% 30%');b.im.style.filter='brightness(1.02) saturate(1.04)';mk(sc,'sh','background:'+GB(48));
 const tg=mk(sc,'tag','left:72px;top:1150px;opacity:0','Phase 1 · promised');
 const n=num(sc,'left:56px;top:1206px;color:#fff;font-size:180px');
 const u=T(sc,'M ts','left:70px;top:1390px;width:960px',[['homes',wt('homes',3)],['in',wt('in',4)],['≈',wt('about',2)],['18',wt('eighteen'),'hl'],['months',wt('months')]]);
 const b0=wt('phase')-.1,tn=wt('ten',2)-b0;
 return t=>{b.style.transform=`scale(1.5) translateY(${-60+120*eio(t/3.8)}px)`;fade(tg,t,.05,.2,10);cnt(n,t,tn,.7,p=>inr(Math.round(10000*p/100)*100));rv(u,t)}},true);
// 13. Loop: back to the frame-0 aerial. "What would you build here? Number two is coming next."
add(wt('what')-.1,sc=>{const b=hookImg(sc);b.im.style.filter='brightness(1.12) saturate(1.1) contrast(1.03)';mk(sc,'sh','background:'+GTOP+')');mk(sc,'sh','background:'+GB(46));
 const h=T(sc,'H ts','left:70px;top:1220px;width:960px;font-size:104px',[['What',wt('what')],['would',wt('would')],['you',wt('you')],['\n'],['build',wt('build'),'hl',1],['here?',wt('here')]]);
 const tg=mk(sc,'tagw','left:72px;top:1460px;opacity:0','Why India looks like this · #2 next');
 const b0=wt('what')-.1;
 return t=>{b.style.transform=`scale(${1.3-.24*eio(t/2.6)}) translateY(${-20+20*eio(t/2.6)}px)`;rv(h,t);fade(tg,t,wt('number')-b0,.25,14)}},true);
